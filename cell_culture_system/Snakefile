        echo "Starting cluster marker and pathway analysis for {wildcards.sample}"

        source $(dirname $(dirname $(which conda)))/etc/profile.d/conda.sh
        conda activate {SCANPY_ENV}

        python {params.script} \
            --input   {input.h5ad} \
