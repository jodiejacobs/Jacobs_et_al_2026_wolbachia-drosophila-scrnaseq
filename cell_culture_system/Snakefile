        echo {input.coverage_files} | tr ' ' '\\n' > {output.plot_dir}/coverage_files.txt
        
        python {params.script} {output.plot_dir}/coverage_files.txt \
            --output-dir {output.plot_dir}
        
        echo "Coverage plotting complete"
        """

